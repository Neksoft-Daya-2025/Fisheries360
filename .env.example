# Local development defaults. Copy to .env if overrides are needed.
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data
# Set only after the exact hosting origin is confirmed, e.g. https://approved-host
# SITE_URL=
# APP_ORIGIN=
# TRUST_PROXY=1 only behind a single trusted reverse proxy
# Optional SMTP: notifications are queued persistently; saving does not imply delivery.
# Destination is fixed server-side to info@neksoftconsultancy.com.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASS=
